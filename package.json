{
  "name": "dsh-windows-bash",
  "version": "0.1.3",
  "description": "DSH Windows default shell policy plugin: probe git-bash/MSYS2, switch bash/pwsh from the plugin config card, register the bash tool, and hide the other shell per agent with tools.restrict. DSH Windows 默认 Shell 策略插件：探测 git-bash，配置面板切换 bash/pwsh，动态注册 bash 工具，并按 agent 用 tools.restrict 隐藏另一个 shell",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "NOTICE"
  ],
  "license": "MIT",
  "author": {
    "name": "qiansanyu",
    "url": "https://github.com/qiansanyu"
  },
  "contributors": [
    {
      "name": "LAN-TINA-WS",
      "url": "https://github.com/LAN-TINA-WS",
      "comment": "原作者；本仓库源自 https://github.com/LAN-TINA-WS/dsh-windows-shell-policy，已独立维护"
    }
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "shell",
    "bash",
    "git-bash",
    "windows",
    "pwsh"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiansanyu/dsh-windows-bash.git"
  },
  "homepage": "https://github.com/qiansanyu/dsh-windows-bash#readme",
  "bugs": {
    "url": "https://github.com/qiansanyu/dsh-windows-bash/issues"
  },
  "engines": {
    "node": ">=22.12.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-sandbox": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.2-rc.1 <0.3.0-0",
    "schemastery": "npm:@deepseek-ai/schemastery@~3.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-jobs": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-subprocess": ">=0.0.1-rc <2",
    "cordis": ">=4.0.0-rc <5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/dsh-agent": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-jobs": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.2-rc.1 <0.3.0-0",
    "@types/node": "^24.13.3",
    "cordis": "4.0.0-rc.10",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:tsc": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
